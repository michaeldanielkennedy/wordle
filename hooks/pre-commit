#!/bin/sh
# Bump the ?v= cache-busting number in index.html when an asset changes.
if git diff --cached --name-only | grep -qE '^(app|words|config)\.js$|^style\.css$'; then
  cur=$(grep -o 'app.js?v=[0-9]*' index.html | grep -o '[0-9]*$')
  new=$(( ${cur:-0} + 1 ))
  sed -i.bak -E "s/\?v=[0-9]+/?v=$new/g" index.html && rm -f index.html.bak
  git add index.html
fi
